# ==============================================================================
# CIPHER-X ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace all default/sample values.
# NEVER commit actual production secrets, API tokens, or keys to version control.

# Core System
ENVIRONMENT=production
APP_NAME="Cipher-X Security & Compliance Platform"
APP_VERSION="3.0.0"
API_V1_PREFIX="/api/v1"

# Security & Cryptography (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite+aiosqlite:///./cipherx.db
# DATABASE_URL=postgresql+asyncpg://cipherx_user:change_password@localhost:5432/cipherx_db

# Redis Broker & Cache
REDIS_URL=redis://localhost:6379/0

# Storage Subsystem (local or s3)
STORAGE_TYPE=local
STORAGE_PATH=./data_storage
S3_BUCKET_NAME=cipherx-audit-artifacts
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Security Provider & Grounded Engine
AI_PROVIDER=deterministic_grounded
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro

# Observability & Rate Limiting
RATE_LIMIT_PER_MINUTE=180
LOG_LEVEL=INFO

# Outbound Integrations (Optional)
SMTP_HOST=smtp.enterprise.internal
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
MS_TEAMS_WEBHOOK_URL=
