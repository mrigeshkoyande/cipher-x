# CIPHER-X Production Environment Configuration

# Project Info
PROJECT_NAME=CIPHER-X
VERSION=1.0.0
ENVIRONMENT=production

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=true

# Database Connection (SQLite default, PostgreSQL supported e.g. postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./cipherx.db

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# AI Engine Provider ("mock", "gemini", "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
